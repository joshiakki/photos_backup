# Copy this file to .env and fill in a real secret before running docker-compose.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Path to the folder on your external HDD where backups + the database will live.
# Find your mount point first with `lsblk -f` or `df -h` (see README.md section 1).
HDD_PATH=/mnt/external_hdd/photobackup

# Default admin account, created automatically the first time the server starts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_me_with_a_long_random_password

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (type: Web application)
# Used to verify "Sign in with Google" on both the web page and the Android app.
GOOGLE_CLIENT_ID=replace_me_with_your_client_id.apps.googleusercontent.com

# From Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Install connector
TUNNEL_TOKEN=replace_me_with_the_cloudflare_tunnel_token
