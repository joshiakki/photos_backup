# Copy this file to .env and fill in a real secret before running docker-compose.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=replace_me_with_a_long_random_secret

# From Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Install connector
TUNNEL_TOKEN=eyJhIjoiZGQ3YWQzOGU2NWJiZGM3MDZjYWRiNzlhYWUwNmY1MmQiLCJ0IjoiMjUwMmQ2NzktNzViNS00NDdkLWEyNjMtOWYxNmNiNTNiMDE1IiwicyI6Ik5HTTJabVZsWkRrdE0yRTVPUzAwWkRoa0xXRmhaakl0WW1ObVpUZGlOVFprTjJFMiJ9

docker run cloudflare/cloudflared:latest tunnel --no-autoupdate run --token eyJhIjoiZGQ3YWQzOGU2NWJiZGM3MDZjYWRiNzlhYWUwNmY1MmQiLCJ0IjoiMjUwMmQ2NzktNzViNS00NDdkLWEyNjMtOWYxNmNiNTNiMDE1IiwicyI6Ik5HTTJabVZsWkRrdE0yRTVPUzAwWkRoa0xXRmhaakl0WW1ObVpUZGlOVFprTjJFMiJ9

# Add cloudflare gpg key
sudo mkdir -p --mode=0755 /usr/share/keyrings
curl -fsSL https://pkg.cloudflare.com/cloudflare-public-v2.gpg | sudo tee /usr/share/keyrings/cloudflare-public-v2.gpg >/dev/null

# Add this repo to your apt repositories
echo 'deb [signed-by=/usr/share/keyrings/cloudflare-public-v2.gpg] https://pkg.cloudflare.com/cloudflared any main' | sudo tee /etc/apt/sources.list.d/cloudflared.list

# install cloudflared
sudo apt-get update && sudo apt-get install cloudflared

sudo cloudflared service install eyJhIjoiZGQ3YWQzOGU2NWJiZGM3MDZjYWRiNzlhYWUwNmY1MmQiLCJ0IjoiMjUwMmQ2NzktNzViNS00NDdkLWEyNjMtOWYxNmNiNTNiMDE1IiwicyI6Ik5HTTJabVZsWkRrdE0yRTVPUzAwWkRoa0xXRmhaakl0WW1ObVpUZGlOVFprTjJFMiJ9

cloudflared tunnel run --token eyJhIjoiZGQ3YWQzOGU2NWJiZGM3MDZjYWRiNzlhYWUwNmY1MmQiLCJ0IjoiMjUwMmQ2NzktNzViNS00NDdkLWEyNjMtOWYxNmNiNTNiMDE1IiwicyI6Ik5HTTJabVZsWkRrdE0yRTVPUzAwWkRoa0xXRmhaakl0WW1ObVpUZGlOVFprTjJFMiJ9