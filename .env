# -----------------------------------
# Flask Configuration
# -----------------------------------

SECRET_KEY=change_this_to_a_long_random_secret_key

JWT_SECRET_KEY=change_this_to_a_long_random_jwt_secret_key


# -----------------------------------
# MySQL Configuration
# -----------------------------------

DB_HOST=mysql
DB_PORT=3306

DB_NAME=media_gallery

DB_USER=mediauser

DB_PASSWORD=mediapassword


# -----------------------------------
# Storage Configuration
# -----------------------------------

# This path will be mounted from your external HDD

UPLOAD_FOLDER=/app/uploads


# -----------------------------------
# Upload Settings
# -----------------------------------

MAX_UPLOAD_SIZE=5368709120


# -----------------------------------
# Environment
# -----------------------------------

FLASK_ENV=production

CF_TUNNEL_TOKEN=paste_your_cloudflare_tunnel_token_here